NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Paste your MongoDB Atlas connection string after the equals sign. Do not commit this file.
MONGODB_URI=
# Optional comma-separated DNS resolvers for MongoDB SRV lookups.
# Defaults to Cloudflare and Google DNS when omitted.
DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
ADMIN_NAME=IMovies Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-development-password
